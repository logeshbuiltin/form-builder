{
  "name": "lths-form-builder",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4502 --proxy-config proxy.conf.json",
    "start-dev": "ng serve --port 4502 --proxy-config proxy.conf.dev.json",
    "build": "ng build --base-href=./",
    "build-dev": "ng build --project=form-builder --base-href=./ --configuration dev",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "artifactregistry-login": "npx google-artifactregistry-auth"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.0.0",
    "@angular/cdk": "^14.0.0",
    "@angular/common": "^14.0.0",
    "@angular/compiler": "^14.0.0",
    "@angular/core": "^14.0.0",
    "@angular/forms": "^14.0.0",
    "@angular/platform-browser": "^14.0.0",
    "@angular/platform-browser-dynamic": "^14.0.0",
    "@angular/router": "^14.0.0",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "chart.js": "^3.3.2",
    "file-saver": "^2.0.5",
    "grapesjs": "0.22.5",
    "grapesjs-blocks-basic": "^1.0.1",
    "grapesjs-blocks-bootstrap4": "^0.2.3",
    "grapesjs-blocks-table": "^0.0.118",
    "grapesjs-component-code-editor": "^1.0.20",
    "grapesjs-plugin-forms": "^2.0.5",
    "grapesjs-preset-webpage": "^1.0.2",
    "grapesjs-script-editor": "^1.0.3",
    "ngx-cookie-service": "^14.0.1",
    "primeflex": "^3.2.0",
    "primeicons": "5.0.0",
    "primeng": "14.0.0",
    "prismjs": "^1.29.0",
    "rxjs": "~7.5.0",
